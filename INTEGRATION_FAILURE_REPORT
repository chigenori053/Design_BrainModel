Command:
cargo test -p design_cli --test integration runtime_bootstrap_isolation::repl_bootstrap_does_not_enter_nl_pipeline -- --nocapture

test_name:
runtime_bootstrap_isolation::repl_bootstrap_does_not_enter_nl_pipeline

assertion:
apps/cli/tests/integration/runtime_bootstrap_isolation.rs:34
assert!(!combined.contains("[ROUTE]"), "{combined}")

expected:
combined stdout/stderr does not contain "[ROUTE]"

actual:
bootstrap.status=exit status: 0
stdout contains:
"[ROUTE][id=1] kind=SlashCommand reason=\"starts_with('/')\""
"[ROUTE][id=1] input=\"/exit\""
"[ROUTE][id=1] normalized=\"exit\""
stderr contains:
"[IR-TRACE][CONTEXT_LOAD] previous_analysis_context=None previous_plan_context=None previous_validation_context=None selected_candidate=None validated_plan=None"

root_cause:
RC-B3: Bootstrap Runtime Failure. REPL startup itself prints the expected banner,
but /exit is routed through Core as a SlashCommand and policy evaluation runs,
which emits [ROUTE] output and fails the isolation assertion.
